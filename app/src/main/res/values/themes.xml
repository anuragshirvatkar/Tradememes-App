<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Memeschain" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/pink3</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowDisablePreview">true</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.Memeschain.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

<style name="SplashTheme" parent="Theme.AppCompat.Light.NoActionBar">
    <item name="android:windowBackground">@color/pink3</item>
    <item name="colorPrimary">@color/pink3</item>
    <item name="colorPrimaryDark">@color/pink3</item>
    <item name="colorAccent">@color/pink3</item>
    <item name="colorPrimaryVariant">@color/pink3</item>
    <!-- Secondary brand color. -->
    <item name="android:statusBarColor">@color/pink3</item>
    <item name="android:windowDisablePreview">true</item>

</style>

    <style name="Theme.Memeschain.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.Memeschain.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>